# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+psycopg2://wheelsync:wheelsync@localhost:5432/wheelsync

# ---- Auth ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# development | production  (production refuses to start with the default JWT_SECRET)
ENVIRONMENT=development

# ---- Networking ----
# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# URL browsers use to reach THIS API; used to build vehicle image / document links.
PUBLIC_BASE_URL=http://localhost:8000

# ---- File storage (vehicle photos + customer documents) ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- Business ----
TIMEZONE=Asia/Manila
RENTAL_ADDRESS=Zone 7, Kauswagan Highway, Cagayan de Oro City

# ---- Account activation + booking email (SMTP preferred; Resend is an optional fallback) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Use a provider/app password; do not put your normal account password here.
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
RESEND_API_KEY=
EMAIL_FROM=Pardz Car Rental <verified-sender@example.com>

# ---- First admin ----
# The /auth/signup endpoint can create an admin ONLY while no admin exists.
# Set to false to disable that and create the admin with scripts/create_admin.py instead.
ALLOW_ADMIN_SIGNUP=true
